<UserControl x:Class="StudentsDB.View.Controls.StudentViewItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StudentsDB.View.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel HorizontalAlignment="Center" Margin="10">
        <TextBlock Name="StudentId" Text="{Binding Path=Id}" Width="150"></TextBlock>
        <TextBlock Name="StudentName" Text="{Binding Path=Name}" Width="150"></TextBlock>
        <TextBlock Name="StudentClass" Text="{Binding Path=Class.Name}" Width="150"></TextBlock>

    </StackPanel>
</UserControl>
